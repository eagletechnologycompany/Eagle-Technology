# Public canonical site URL used for sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://eagle-technology.example

# Founder Operations Dashboard — Session & Security Secrets (Server-only)
# Generate a strong 32+ character random string for production:
EAGLE_SESSION_SECRET=replace-with-a-strong-32-char-random-secret-in-production

# Optional custom SQLite & private document paths
# EAGLE_DB_PATH=./data/eagle-ops.db
# EAGLE_STORAGE_DIR=./storage/documents

# Bootstrap password for initial role seeding (change in Settings after first login)
# EAGLE_FOUNDER_BOOTSTRAP_PASSWORD=change-me-before-production-deploy

# Optional contact delivery settings (leave unset for validation-only preview mode)
# CONTACT_RECIPIENT_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
